# Dokploy Environment oynasiga shu fayl mazmunini kiriting. Haqiqiy sirlarni Git'ga qo'ymang.
POSTGRES_USER=bestteam
POSTGRES_PASSWORD=replace_with_url_safe_random_password
POSTGRES_DB=best_team_news
DATABASE_URL=postgresql://bestteam:replace_with_url_safe_random_password@postgres:5432/best_team_news?schema=public
REDIS_URL=redis://redis:6379

NODE_ENV=production
JWT_ACCESS_SECRET=replace_with_64_hex_characters
JWT_REFRESH_SECRET=replace_with_another_64_hex_characters
BOT_SERVICE_SECRET=replace_with_at_least_48_random_characters

ADMIN_EMAIL=admin@bestteam.uz
ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
# Optional. Set this to create a separate editor account on a fresh database.
EDITOR_PASSWORD=
BOT_ADMIN_IDS=replace_with_your_numeric_telegram_id

FRONTEND_URL=https://jahonxabarlari.uz
FRONTEND_URLS=https://jahonxabarlari.uz,https://www.jahonxabarlari.uz
BACKEND_PUBLIC_URL=https://api.jahonxabarlari.uz
NEXT_PUBLIC_API_URL=https://api.jahonxabarlari.uz/api
INTERNAL_API_URL=http://backend:4000/api
NEXT_PUBLIC_SITE_URL=https://jahonxabarlari.uz
ADMIN_PANEL_URL=https://jahonxabarlari.uz/admin

GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# VAPID_PUBLIC_KEY va VAPID_PRIVATE_KEY faqat push bildirishnomalar ishlatilsa Railway'dan ko'chiriladi.
VAPID_SUBJECT=mailto:info@bestteam.uz
WEATHERAPI_API_KEY=
OPENAI_API_KEY=

BOT_TOKEN=replace_with_real_telegram_bot_token
TELEGRAM_CHANNEL_POSTING_ENABLED=false
# TELEGRAM_CHANNEL_BOT_TOKEN ni kanalga yuborish yoqilganda Railway'dan ko'chiring.
TELEGRAM_NEWS_CHANNEL=@BESTTeam_uz
TELEGRAM_CHANNEL_CUSTOM_EMOJI_ID=
TELEGRAM_CHANNEL_CUSTOM_EMOJI_ALT=
FORWARD_CONCURRENCY=5
MEDIA_GROUP_DELAY_SECONDS=2.5

# Faqat true yoki false yozing. Masalan "folse" kabi typo backendni ishga tushirmaydi.
INSTAGRAM_POSTING_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_MODE=instagram_login
INSTAGRAM_GRAPH_API_VERSION=v24.0
INSTAGRAM_WORKER_CONCURRENCY=1
INSTAGRAM_DIRECT_ENABLED=false
INSTAGRAM_DIRECT_AUTO_REPLY_ENABLED=false
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

MEDIA_RENDERER_URL=https://media.jahonxabarlari.uz
MEDIA_RENDERER_SECRET=replace_with_64_hex_characters
MAX_CONCURRENT_RENDERS=1

NEWS_AGGREGATOR_ENABLED=true
NEWS_AGGREGATOR_INTERVAL_MINUTES=5
SEED_DEMO_CONTENT=false
